# Copy this file to terraform.tfvars and fill in the values.
# terraform.tfvars is git-ignored.

# Allowed IP addresses (CIDR notation)
# ADR-0014: CloudFront の WAF IPSet で評価される
allowed_cidr = ["x.x.x.x/32", "y.y.y.y/32"]

# SES sender email address for monthly reports
# (AWS からの検証メールがこのアドレスに届く)
ses_sender_email = "your-email@example.com"
